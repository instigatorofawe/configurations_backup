general {
        colors = true
        interval = 1
}

order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "cpu_usage"
order += "load"
order += "memory"
order += "volume master"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality) %ip"
        format_down = "W: disconnected"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: disconnected"
}

battery all { 
        format = "%status %percentage %remaining"
}

disk "/" {
        format = " %avail"
}

cpu_usage {
        format = " %usage"
}

load {
        format = "%1min %5min %15min"
}

memory {
        format = " %used/%total"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = " %A, %B %d, %Y %I:%M:%S %p "
}

volume master {
        format = "♪: %volume"
        format_muted = "♪: muted (%volume)"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}
